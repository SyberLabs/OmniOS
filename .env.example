# ============================================
# OMNI_OS — Environment Configuration
# ============================================
# Copy this file to `.env` and fill in the keys you need.
# `.env*` is gitignored — never commit real keys.
#
# This is a LOCAL-FIRST, SINGLE-USER app. All keys below are read
# server-side (process.env) and are never sent to or stored in the browser.
# Public hosting would expose these keys to every visitor and must add
# authentication first. See IMPLEMENTATION_PLAN.md.

# --- LLM providers (Mind / personas) ---
# Local (Ollama) needs no key. Set the URL only if Ollama runs elsewhere.
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# --- Data APIs ---
# NewsAPI — https://newsapi.org/
NEWSAPI_KEY=

# Polymarket uses a public API and needs no key.

# --- Debugging ---
# Set to 1 to enable verbose gateway/block diagnostic logging in the console.
NEXT_PUBLIC_OMNI_DEBUG=
